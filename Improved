### 2.3 Spacing, radius, elevation, motion
 
```css
:root {
  /* spacing (4px base) */
  --space-1: 4px;  --space-2: 8px;  --space-3: 12px; --space-4: 16px;
  --space-5: 20px; --space-6: 24px; --space-8: 32px; --space-12: 48px;
 
  /* radius: 4 sizes, bas */
  --radius-sm: 6px;   /* chips, badges */
  --radius-md: 8px;   /* buttons, inputs */
  --radius-lg: 12px;  /* cards */
  --radius-xl: 16px;  /* modals, panels */
 
  /* elevation = border + shade, shadow sirf overlays pe */
  --shadow-overlay: 0 16px 40px -12px rgba(0,0,0,.65);
 
  /* controls */
  --control-h-sm: 32px; --control-h-md: 40px; --control-h-lg: 48px;
  --focus-ring: 0 0 0 2px var(--color-bg-canvas), 0 0 0 4px var(--color-accent);
 
  /* motion */
  --dur-fast: 150ms; --dur-base: 220ms;
  --ease-out: cubic-bezier(.2,.8,.2,1);
 
  /* z-index */
  --z-sticky: 100; --z-dropdown: 200; --z-drawer: 300;
  --z-copilot: 350; --z-modal: 400; --z-toast: 500;
 
  /* layout */
  --content-max: 1280px; --gutter: 24px; --nav-h: 64px;
}
@media (max-width: 640px) { :root { --gutter: 16px; } }
@media (prefers-reduced-motion: reduce) { * { transition-duration: .01ms !important; animation: none !important; } }
```
 
